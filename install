#!/bin/bash

echo "🚀 Démarrage de l'installation Emacs-Revolution..."

echo "[1/4] Création du dossier ~/.emacs.d/..."
mkdir -p $HOME/.emacs.d/

echo "[2/4] Copie des extensions..."
mkdir -p $HOME/.emacs.d/revolution
cp -r $PWD/.emacs.d/revolution $HOME/.emacs.d/

echo "[3/4] Copie des dépendances..."
mkdir -p $HOME/.emacs.d/github
cp -r $PWD/.emacs.d/github $HOME/.emacs.d/

echo "[4/4] Copie du fichier de configuration..."
cp $PWD/.emacs $HOME/

echo "✅ Installation terminée avec succès !"
echo "N'oubliez pas de lancer Emacs pour initialiser la configuration."
